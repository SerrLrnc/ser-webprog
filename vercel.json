{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/ser-server/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/ser-client/$1"
    }
  ],
  "builds": [
    {
      "src": "ser-client/**",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "ser-client/dist"
      }
    },
    {
      "src": "ser-server/index.js",
      "use": "@vercel/node"
    }
  ]
}